# Desenvolvimento local (Docker)
POSTGRES_DB=cfit
POSTGRES_USER=cfit
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Produção (Neon). Use a URL pooled com SSL no painel da Vercel.
DATABASE_URL=

DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_REGEXES=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Cfit <acesso@seu-dominio.com>
DJANGO_BOOTSTRAP_SUPERUSER_EMAIL=
DJANGO_BOOTSTRAP_SUPERUSER_PASSWORD=
